# Local Compose configuration. Optional: copy to .env to override demo defaults.
# Local demo placeholders only; replace before any non-local use.
MYSQL_DATABASE=material_studio
MYSQL_USER=material_app
MYSQL_PASSWORD=local-demo-change-me
MYSQL_ROOT_PASSWORD=local-root-change-me
FRONTEND_PORT=3000
JAVA_DB_URL=jdbc:mysql://mysql:3306/material_studio?connectionTimeZone=UTC
JAVA_DB_USERNAME=material_app
JAVA_DB_PASSWORD=local-demo-change-me
BACKEND_INTERNAL_URL=http://backend:8080
APP_PUBLIC_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=7
STORAGE_ROOT=/data/materials
TASK_QUEUE_CAPACITY=20
SIMULATION_CONTROLS_ENABLED=true
SIMULATION_ASSET_CHECK_DELAY_MS=1000
SIMULATION_GENERATE_DELAY_MS=5000
SIMULATION_FINALIZE_DELAY_MS=1000
